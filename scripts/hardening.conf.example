# /etc/vaultwarden-hardening.conf （root 所有，chmod 600）
# 由菜单 [01] 生成并自动填写；一般不需要手动修改。
# 留空则自动识别；若已安装 vbm，会只读复用 /etc/vaultwarden-backup.conf 中的实例。
# 多个 Vaultwarden 实例时，在这里填写容器 /data 对应的主机路径。
VW_DATA_DIR=""
VW_CONTAINER=""
# 可选：1Panel 自定义安装目录时，填写其持久防火墙规则目录（通常自动识别，无需填写）
# PANEL_FIREWALL_DIR="/opt/1panel/firewall"
